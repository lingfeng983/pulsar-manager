{
    "appId": "com.pulsar.manager",
    "productName": "Pulsar Manager",
    "copyright": "Copyright (C) Pulsar Manager Team",
    "afterPack": "./scripts/after-pack.js",
    "directories": {
        "output": "release",
        "buildResources": "build"
    },
    "files": ["dist/**/*", "package.json", "!**/*.map", "!**/*.tsbuildinfo"],
    "asarUnpack": [
        "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
        "node_modules/pulsar-client/lib/binding/pulsar.node"
    ],
    "npmRebuild": false,
    "win": {
        "artifactName": "Pulsar管理工具-安装包-${version}.${ext}",
        "target": [
            {
                "target": "nsis",
                "arch": ["x64"]
            }
        ],
        "signAndEditExecutable": false
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true
    },
    "mac": {
        "target": ["dmg"],
        "category": "public.app-category.developer-tools"
    },
    "linux": {
        "target": ["AppImage", "deb"],
        "category": "Development"
    }
}
