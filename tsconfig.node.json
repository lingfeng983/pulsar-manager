{
    "compilerOptions": {
        "composite": true,
        "skipLibCheck": true,
        "module": "CommonJS",
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "strict": false,
        "noImplicitAny": false,
        "outDir": "dist",
        // 不设 rootDir：产物因此落在 dist/src/shared/**，而 scripts/doc-kb-selftest.cjs
        // 就按这个路径 require。加了 rootDir 会挪成 dist/shared/**，自测直接找不到模块。
        "sourceMap": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "target": "ES2020",
        "lib": ["ES2020"]
    },
    "include": ["src/shared/**/*"]
}
