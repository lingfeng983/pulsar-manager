{
    "name": "pulsar-manager",
    "version": "1.6.3",
    "description": "Apache Pulsar 桌面运维客户端：集群管理、消息收发、快速压测、监控巡检、告警通知一站式工具",
    "private": true,
    "author": "Pulsar Manager Team",
    "license": "Apache-2.0",
    "homepage": "https://github.com/lingfeng983/pulsar-manager",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lingfeng983/pulsar-manager.git"
    },
    "bugs": {
        "url": "https://github.com/lingfeng983/pulsar-manager/issues"
    },
    "scripts": {
        "dev": "vite",
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "npm run clean && tsc -b && npm run build:shared && npm run build:renderer",
        "build:shared": "tsc -p tsconfig.node.json",
        "build:renderer": "vite build",
        "typecheck": "tsc -b --force",
        "app:dev": "npm run build:renderer && cd rust && cargo run -p pm-tauri",
        "app:build": "npm run build:renderer && cd rust/crates/pm-tauri && npx tauri build",
        "test:rust": "cd rust && cargo test --workspace",
        "selftest": "node scripts/template-engine-selftest.mjs",
        "selftest:docs": "npm run build:shared && node scripts/doc-kb-selftest.cjs",
        "icon": "node scripts/make-icon.mjs",
        "release": "node scripts/release-publish.mjs",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
    },
    "devDependencies": {
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-xml": "^6.1.0",
        "@codemirror/language": "^6.13.1",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.14",
        "@eslint/js": "9.39.5",
        "@lezer/highlight": "^1.2.5",
        "@tauri-apps/cli": "^2.12.3",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/uuid": "^9.0.8",
        "@vitejs/plugin-react": "^4.2.1",
        "antd": "^5.14.0",
        "dayjs": "^1.11.10",
        "dompurify": "^3.4.17",
        "echarts": "^5.4.3",
        "echarts-for-react": "^3.0.2",
        "eslint": "9.39.5",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "5.2.0",
        "marked": "^18.1.1",
        "prettier": "3.9.6",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-resizable": "^4.0.2",
        "typescript": "^5.6.3",
        "typescript-eslint": "8.67.0",
        "uuid": "^9.0.1",
        "vite": "^5.1.0",
        "zod": "^3.22.4",
        "zustand": "^4.5.0"
    }
}
