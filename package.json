{
  "name": "pulsar-manager",
  "version": "1.2.0",
  "description": "Pulsar Desktop Management Tool",
  "private": true,
  "main": "dist/src/main/index.js",
  "author": "Pulsar Manager Team",
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "npm run build:main && electron .",
    "dev:renderer": "vite",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -b && npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "electron:pack": "npm run build && electron-builder --dir && npm run verify:package",
    "electron:dist": "npm run build && electron-builder && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "axios": "^1.6.7",
    "better-sqlite3": "^9.4.3",
    "pulsar-client": "^1.18.0",
    "ssh2": "^1.17.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/better-sqlite3": "^7.6.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.6",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "antd": "^5.14.0",
    "concurrently": "^8.2.2",
    "dayjs": "^1.11.10",
    "echarts": "^5.4.3",
    "echarts-for-react": "^3.0.2",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.67.0",
    "vite": "^5.1.0",
    "ws": "^8.18.0",
    "zustand": "^4.5.0"
  }
}
