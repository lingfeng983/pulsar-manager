{
  "name": "pulsar-manager",
  "version": "1.0.0",
  "description": "Pulsar Desktop Management Tool",
  "main": "dist/src/main/index.js",
  "author": "Pulsar Manager Team",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.node.json && electron .",
    "dev:renderer": "vite",
    "build": "tsc -b && vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder"
  },
  "dependencies": {
    "antd": "^5.14.0",
    "axios": "^1.6.7",
    "better-sqlite3": "^9.4.3",
    "dayjs": "^1.11.10",
    "echarts": "^5.4.3",
    "echarts-for-react": "^3.0.2",
    "lodash-es": "^4.17.21",
    "node-forge": "^1.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "ssh2": "^1.15.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^5.1.0",
    "vite-plugin-electron": "^0.28.0"
  }
}
